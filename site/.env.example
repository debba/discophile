# SMTP server used to deliver TestFlight requests
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for implicit TLS (usually port 465), false for STARTTLS
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown on the notification email
SMTP_FROM="Discophile <noreply@example.com>"
# Where TestFlight requests are delivered
TESTFLIGHT_TO=you@example.com
